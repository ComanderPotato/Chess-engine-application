{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "watch": "tsc --watch --project tsconfig.build.json",
    "server": "tsx watch src/app.ts",
    "dev": "concurrently \"npm:watch\" \"npm:server\"",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "start": "node ./dist/app.js",
    "circular": "npx madge --extensions ts --ts-config tsconfig.json --circular src",
    "clean": "rimraf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.7.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/supertest": "^7.2.0",
    "mongodb-memory-server": "^11.2.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.22.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
